---
import '../styles/global.css';
const instagram='https://instagram.com/julioalvarezrd';
const areas=[['Infraestructura & Servidores','Implementación, configuración y administración de servidores, virtualización y servicios tecnológicos.'],['Redes','Diseño, configuración, mantenimiento y diagnóstico de redes para hogares y organizaciones.'],['Soporte Tecnológico','Diagnóstico, configuración e implementación de soluciones prácticas para necesidades tecnológicas.'],['CCTV & Domótica','Videovigilancia, automatización e integración de tecnología para espacios más seguros e inteligentes.'],['Soluciones Digitales','Aplicaciones y herramientas modernas apoyadas por desarrollo asistido por IA.'],['Impresión 3D','Fabricación digital a través de 3DCow: de una idea o modelo a un objeto físico.']];
const projects=[['SIBOR','Sistema de gestión operativa','Plataforma orientada a centralizar personal, recursos, operaciones e incidencias para organizaciones de respuesta a emergencias.'],['Tu Salario RD','Mercado laboral dominicano','Herramienta digital enfocada en salarios, ingresos e información laboral relevante para República Dominicana.'],['Gestión de Alquileres','En desarrollo','Solución para administrar propiedades residenciales y comerciales, contratos, pagos e inquilinos.'],['3DCow','Impresión 3D','Tecnología, diseño y fabricación digital para transformar modelos e ideas en objetos físicos.']];
---
<!doctype html><html lang="es" data-theme="dark"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width"><meta name="description" content="Julio Alvarez — Ingeniero de Sistemas Computacionales. Infraestructura, redes, servidores y soporte tecnológico."><title>Julio Alvarez · Ingeniero de Sistemas Computacionales</title><link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Manrope:wght@600;700;800&display=swap" rel="stylesheet"></head><body>
<header class="site-header"><a class="brand" href="#top">JA<span>.</span></a><nav><a href="#about" data-es="Sobre mí" data-en="About">Sobre mí</a><a href="#work" data-es="Áreas" data-en="Expertise">Áreas</a><a href="#projects" data-es="Proyectos" data-en="Projects">Proyectos</a><a href="#contact" data-es="Contacto" data-en="Contact">Contacto</a></nav><div class="controls"><button id="lang-toggle" class="ghost-button">EN</button><button id="theme-toggle" class="ghost-button">☼</button></div></header>
<main id="top"><section class="hero section-shell"><div class="hero-copy"><p class="eyebrow" data-es="Ingeniero de Sistemas Computacionales · República Dominicana" data-en="Computer Systems Engineer · Dominican Republic">Ingeniero de Sistemas Computacionales · República Dominicana</p><h1>Julio<br>Alvarez<span>.</span></h1><p class="hero-lead" data-es="Infraestructura, redes, servidores y tecnología aplicada a resolver problemas reales." data-en="Infrastructure, networks, servers and technology applied to real-world problems.">Infraestructura, redes, servidores y tecnología aplicada a resolver problemas reales.</p><div class="hero-actions"><a class="primary-button" href="#projects" data-es="Ver proyectos" data-en="View projects">Ver proyectos</a><a class="secondary-button" href={instagram} target="_blank">Instagram ↗</a></div><div class="skill-row"><span>Servers</span><span>Networking</span><span>Linux</span><span>CCTV</span><span>Automation</span><span>3D Printing</span></div></div><div class="hero-visual"><div class="portrait-wrap"><img src="https://avatars.githubusercontent.com/u/20918278?v=4" alt="Julio Alvarez"></div><div class="status-card"><span class="status-dot"></span><div><strong data-es="Construyendo soluciones" data-en="Building solutions">Construyendo soluciones</strong><small>Infrastructure · Support · Digital</small></div></div></div></section>
<section id="about" class="section-shell text-section"><p class="section-kicker" data-es="Sobre mí" data-en="About me">Sobre mí</p><div><h2 data-es="Tecnología más allá del código." data-en="Technology beyond code.">Tecnología más allá del código.</h2><p data-es="Soy Julio Alvarez, Ingeniero de Sistemas Computacionales apasionado por la infraestructura, las redes y la creación de soluciones útiles. Trabajo con servidores, soporte tecnológico, CCTV, domótica y herramientas digitales, combinando experiencia práctica con nuevas formas de construir apoyadas por inteligencia artificial." data-en="I'm Julio Alvarez, a Computer Systems Engineer passionate about infrastructure, networking and building useful solutions. I work with servers, IT support, CCTV, home automation and digital tools, combining hands-on experience with new AI-assisted ways of building.">Soy Julio Alvarez, Ingeniero de Sistemas Computacionales apasionado por la infraestructura, las redes y la creación de soluciones útiles. Trabajo con servidores, soporte tecnológico, CCTV, domótica y herramientas digitales, combinando experiencia práctica con nuevas formas de construir apoyadas por inteligencia artificial.</p></div></section>
<section id="work" class="section-shell"><div class="section-heading"><div><p class="section-kicker" data-es="Lo que hago" data-en="What I do">Lo que hago</p><h2 data-es="De la red al producto digital." data-en="From the network to the digital product.">De la red al producto digital.</h2></div></div><div class="cards-grid">{areas.map(([name,desc],i)=><article><span>0{i+1}</span><h3>{name}</h3><p>{desc}</p></article>)}</div></section>
<section id="projects" class="section-shell"><p class="section-kicker" data-es="Proyectos" data-en="Projects">Proyectos</p><h2 data-es="Ideas que estoy convirtiendo en sistemas." data-en="Ideas I'm turning into systems.">Ideas que estoy convirtiendo en sistemas.</h2><div class="projects-grid">{projects.map(([name,type,desc],i)=><article class:list={['project-card',i===0&&'featured',name==='3DCow'&&'cow']}><div><p class="project-type">{type}</p><h3>{name}</h3><p>{desc}</p></div><span class="project-mark">{name==='3DCow'?'3D':`0${i+1}`}</span></article>)}</div></section>
<section class="section-shell approach"><p class="section-kicker" data-es="Mi enfoque" data-en="My approach">Mi enfoque</p><blockquote data-es="No me define una sola herramienta. Me define entender el problema y encontrar una solución tecnológica que funcione." data-en="I'm not defined by a single tool. I'm defined by understanding the problem and finding a technology solution that works.">No me define una sola herramienta. Me define entender el problema y encontrar una solución tecnológica que funcione.</blockquote></section>
<section id="contact" class="section-shell contact"><p class="section-kicker" data-es="Contacto" data-en="Contact">Contacto</p><h2 data-es="Hablemos de tecnología." data-en="Let's talk technology.">Hablemos de tecnología.</h2><p data-es="¿Tienes una idea, un proyecto o necesitas ayuda con alguna solución tecnológica? Escríbeme por Instagram." data-en="Have an idea, a project or need help with a technology solution? Reach out on Instagram.">¿Tienes una idea, un proyecto o necesitas ayuda con alguna solución tecnológica? Escríbeme por Instagram.</p><a class="primary-button" href={instagram} target="_blank">@julioalvarezrd ↗</a></section></main><footer class="section-shell"><span>© 2026 Julio Alvarez</span><span data-es="Ingeniero de Sistemas Computacionales" data-en="Computer Systems Engineer">Ingeniero de Sistemas Computacionales</span></footer>
<script is:inline>const r=document.documentElement,t=document.querySelector('#theme-toggle'),l=document.querySelector('#lang-toggle');r.dataset.theme=localStorage.getItem('theme')||(matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light');t.textContent=r.dataset.theme==='dark'?'☼':'☾';t.onclick=()=>{r.dataset.theme=r.dataset.theme==='dark'?'light':'dark';localStorage.setItem('theme',r.dataset.theme);t.textContent=r.dataset.theme==='dark'?'☼':'☾'};let lang=localStorage.getItem('lang')||'es';const apply=()=>{r.lang=lang;document.querySelectorAll('[data-es][data-en]').forEach(e=>e.textContent=e.dataset[lang]);l.textContent=lang==='es'?'EN':'ES'};apply();l.onclick=()=>{lang=lang==='es'?'en':'es';localStorage.setItem('lang',lang);apply()};</script></body></html>
